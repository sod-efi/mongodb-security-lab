{
  "name": "mongodb-security-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MongoDB security assessment tool: vulnerable cluster, recon + lateral movement, interactive report, self-improvement loop.",
  "scripts": {
    "app": "node app/server.mjs",
    "lab:up": "node lab/start-lab.mjs",
    "assess": "node toolkit/mongo-recon.mjs",
    "demo": "node lab/start-lab.mjs --run-demo",
    "demo:discover": "node lab/start-lab.mjs --run-demo --discover",
    "demo:report": "node lab/demo-report.mjs",
    "demo:learn": "node lab/demo-learn.mjs",
    "learn:reset": "node toolkit/reset-learning.mjs"
  },
  "dependencies": {
    "mongodb": "^6.12.0",
    "mongodb-memory-server-core": "^10.1.3"
  }
}
